# Copy to .env and fill in. Never commit real values.

# PostgreSQL (Supabase) connection string for production:
# Supabase session pooler, dedicated schema; connection_limit=1 for serverless:
# DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require&schema=meridian_air&connection_limit=1&pool_timeout=10"
# Local development uses SQLite:
DATABASE_URL="file:./dev.db"

# Auth — random 32+ char string (openssl rand -base64 32)
AUTH_SECRET=

# Discord bot
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Discord webhooks used by the web app (optional; bot can post directly instead)
DISCORD_WEBHOOK_BOOKINGS=
DISCORD_WEBHOOK_PIREPS=
DISCORD_WEBHOOK_ANNOUNCEMENTS=

# IVAO API key (VATSIM public API needs no key)
IVAO_API_KEY=

# Seed admin (consumed by `npm run db:seed` only)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
